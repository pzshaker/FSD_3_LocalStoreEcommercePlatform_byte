MONGODB_URI=
MONGODB_DB=bakery
APP_ORIGIN=http://localhost:5173
PORT=3001
# Optional locally; required for product image uploads.
BLOB_READ_WRITE_TOKEN=
# Defaults to the current Africa/Cairo assumption.
BAKERY_TIMEZONE=Africa/Cairo
# Set NODE_ENV=production and APP_ORIGIN to your HTTPS URL on Vercel.
# Private CLI setup only; these values never reach the React bundle.
OWNER_EMAIL=
OWNER_PASSWORD=
