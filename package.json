{
  "name": "bakery-ordering-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "owner:setup": "node --env-file-if-exists=.env scripts/setup-owner.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "seed:sample": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@vercel/blob": "^2.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "mongodb-memory-server-core": "^11.3.0",
    "vite": "^8.3.3"
  }
}
